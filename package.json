{
  "name": "spbf",
  "version": "0.1.0",
  "private": true,
  "description": "小说浏览器：浏览、下书、阅读、AI",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:live-ai": "node scripts/ai-live-smoke.mjs",
    "e2e:startup": "node scripts/startup-fallback-e2e.mjs",
    "e2e:ocr": "node scripts/ocr-download-e2e.mjs",
    "pack": "npm run typecheck && electron-vite build && electron-builder --dir",
    "dist": "npm run typecheck && electron-vite build && electron-builder"
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.18.2",
    "@mozilla/readability": "^0.6.0",
    "jsdom": "^30.0.1",
    "jszip": "^3.10.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "naive-ui": "^2.44.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "vue": "^3.5.41"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron@43.4.0": true,
    "electron-winstaller@5.4.0": true
  }
}
